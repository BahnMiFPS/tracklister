# Recognition: AudD token (https://dashboard.audd.io). Empty = Shazam only (slow).
AUDD_API_TOKEN=
# Original-release BPM + key (https://getsongbpm.com/api).
GETSONGBPM_API_KEY=

# Copy to .env and fill in. Create a free app at https://developer.spotify.com/dashboard
# (any name, redirect URI http://127.0.0.1:8765/callback), then copy its Client ID / Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Seconds between Shazam requests. Lower = faster but more rate-limit pauses.
TL_MIN_INTERVAL=9
# Seconds between samples in the mix.
TL_STEP=30
